# Mail delivery (server only — never prefix with VITE_)
# mock | resend | postmark | sendgrid | ses
MAIL_PROVIDER=mock
RESEND_API_KEY=
MAIL_FROM_EMAIL=proposals@your-verified-domain.com
MAIL_FROM_NAME=ProposalForge
MAIL_APP_URL=http://localhost:5173

# Optional. Required for Delivered / Bounced events from Resend.
RESEND_WEBHOOK_SECRET=
