# Mail delivery (server only — never prefix with VITE_)
# mock | resend | postmark | sendgrid | ses
MAIL_PROVIDER=mock
RESEND_API_KEY=
MAIL_FROM_EMAIL=proposals@your-verified-domain.com
MAIL_FROM_NAME=ProposalForge
MAIL_APP_URL=http://localhost:5173

# Optional. Required for Delivered / Bounced events from Resend.
RESEND_WEBHOOK_SECRET=

# AI improvement engine (server only — never prefix with VITE_)
# openai | anthropic | gemini | local | mock
AI_PROVIDER=mock
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=1200
AI_STREAMING=true
AI_TIMEOUT_MS=60000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI-compatible local server (Ollama, LM Studio, vLLM)
LOCAL_AI_URL=
LOCAL_AI_MODEL=llama3.1
LOCAL_AI_API_KEY=
